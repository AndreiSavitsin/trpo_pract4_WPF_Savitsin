<Window x:Class="trpo_pract4_Savitsin_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:trpo_pract4_Savitsin_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Label Content="ID"/>
            <Label Content="Название файла"/>
            <Label Content="Количество страниц"/>
            <Label Content="Количество копий"/>
            <Label Content="Стоимость страницы"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="4">
            
            <TextBlock Text="Идентификатор:"/>
            <TextBlock Text="{Binding Id}"/>

            <TextBlock Text="Имя:"/>
            <TextBlock Text="{Binding Name}"/>

            <TextBlock Text="Количество страниц:"/>
            <TextBlock Text="{Binding CountPage}"/>

            <TextBlock Text="Количество копий:"/>
            <TextBlock Text="{Binding CountCopies}"/>

            <TextBlock Text="Стоимость страницы:"/>
            <TextBlock Text="{Binding PricePage}"/>

            <TextBlock Text="Стоимость печати:"/>
            <TextBlock Text="{Binding PricePrint}"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1">
            <Button Margin="5" x:Name="btnSave" Content="Сохранить" Height="30" Width="100" Click="btnSave_Click"/>
            <Button Margin="5" x:Name="btnNewRecord" Content="Новая запись" Height="30" Width="100" Click="btnNewRecord_Click"/>
            <TextBlock Margin="5" Height="20" Text="Введите ID" Width="100"/>
            <TextBox Margin="5" x:Name="txtSearchID" Height="30" Width="100"/>
            <Button Margin="5" x:Name="btnSearch" Content="Найти" Height="30" Width="100" Click="btnSearch_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0">

            <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="10, 5, 0, 0" x:Name="txtId" Text="{Binding Id, Mode=OneWay}" Width="150" Height="20"/>

            <TextBox HorizontalAlignment="Left" Margin="10, 5, 0, 0" x:Name="txtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="20"/>

            <TextBox HorizontalAlignment="Left" Margin="10, 5, 0, 0" x:Name="txtCountPage" Text="{Binding CountPage, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="20"/>

            <TextBox HorizontalAlignment="Left" Margin="10, 5, 0, 0" x:Name="txtCountCopies" Text="{Binding CountCopies, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="20"/>

            <TextBox HorizontalAlignment="Left" Margin="10, 5, 0, 0" x:Name="txtPricePage" Text="{Binding PricePage, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="20"/>

        </StackPanel>
    </Grid>
</Window>
